[project]
org="savoirfairelinux"
name="vulnscout"
build_context=.

[build]
command="make -C tests"
flavors="test test_backend test_frontend test_ci test_duplication test_complexity validate_sbom documentation"

[test]
command="make -C tests test"

[test_backend]
command="make -C tests test_backend"

[test_frontend]
command="make -C tests test_frontend"

[test_ci]
command="make -C tests test_ci"
docker_run_args="-v /run/docker.sock:/run/docker.sock"

[test_duplication]
command="make -C tests test_duplication"

[test_complexity]
command="make -C tests test_complexity"

[validate_sbom]
command="make -C tests validate_sbom"

[documentation]
command="make -C doc html"
